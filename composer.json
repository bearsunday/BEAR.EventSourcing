{
    "name": "bear/eccube",
    "description": "EC-CUBE ported to BEAR.Sunday with Event Sourcing",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "BEAR.Sunday",
            "email": "info@bear-sunday.net"
        }
    ],
    "require": {
        "php": "^8.1",
        "bear/sunday": "^1.0",
        "bear/package": "^1.0",
        "bear/resource": "^1.0",
        "ray/aop": "^2.0",
        "ray/di": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "phpstan/phpstan": "^1.0 || ^2.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "BearEccube\\": ["src-v2/", "src/"]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BearEccube\\Tests\\": ["tests/", "tests-v2/"]
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "stan": "phpstan analyse",
        "psalm": "psalm"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "minimum-stability": "stable"
}
