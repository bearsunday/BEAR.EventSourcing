{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "carts.get.json",
  "type": "object",
  "title": "Cart List Response",
  "required": ["carts", "total", "limit", "offset"],
  "properties": {
    "carts": {"type": "array", "items": {"$ref": "#/definitions/Cart"}},
    "total": {"type": "integer", "minimum": 0},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100},
    "offset": {"type": "integer", "minimum": 0}
  },
  "definitions": {
    "Cart": {
      "type": "object",
      "required": ["id", "total_price", "create_date", "update_date"],
      "properties": {
        "id": {"type": "integer"},
        "cart_key": {"type": ["string", "null"]},
        "pre_order_id": {"type": ["string", "null"]},
        "total_price": {"type": "number"},
        "delivery_fee_total": {"type": "number"},
        "sort_no": {"type": ["integer", "null"]},
        "create_date": {"type": "string", "format": "date-time"},
        "update_date": {"type": "string", "format": "date-time"},
        "customer": {"$ref": "#/definitions/Reference"},
        "cart_items": {"type": "array", "items": {"$ref": "#/definitions/Reference"}}
      }
    },
    "Reference": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {"id": {"type": "integer"}, "name": {"type": "string"}}
    }
  }
}
