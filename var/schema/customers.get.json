{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "customers.get.json",
  "type": "object",
  "title": "Customer List Response",
  "required": ["customers", "total", "limit", "offset"],
  "properties": {
    "customers": {
      "type": "array",
      "items": {"$ref": "#/definitions/Customer"}
    },
    "total": {"type": "integer", "minimum": 0},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100},
    "offset": {"type": "integer", "minimum": 0}
  },
  "definitions": {
    "Customer": {
      "type": "object",
      "required": ["id", "name01", "name02", "email", "create_date", "update_date"],
      "properties": {
        "id": {"type": "integer"},
        "name01": {"type": "string"},
        "name02": {"type": "string"},
        "kana01": {"type": ["string", "null"]},
        "kana02": {"type": ["string", "null"]},
        "company_name": {"type": ["string", "null"]},
        "email": {"type": "string", "format": "email"},
        "phone_number": {"type": ["string", "null"]},
        "postal_code": {"type": ["string", "null"]},
        "addr01": {"type": ["string", "null"]},
        "addr02": {"type": ["string", "null"]},
        "birth": {"type": ["string", "null"], "format": "date-time"},
        "buy_times": {"type": ["integer", "null"]},
        "buy_total": {"type": ["number", "null"]},
        "point": {"type": ["number", "null"]},
        "create_date": {"type": "string", "format": "date-time"},
        "update_date": {"type": "string", "format": "date-time"},
        "customer_status": {"$ref": "#/definitions/Reference"},
        "sex": {"$ref": "#/definitions/Reference"},
        "job": {"$ref": "#/definitions/Reference"},
        "country": {"$ref": "#/definitions/Reference"},
        "pref": {"$ref": "#/definitions/Reference"},
        "orders": {
          "type": "array",
          "items": {"$ref": "#/definitions/Reference"}
        }
      }
    },
    "Reference": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "integer"},
        "name": {"type": "string"}
      }
    }
  }
}
