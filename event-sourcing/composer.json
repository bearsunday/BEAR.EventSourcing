{
    "name": "bear/event-sourcing",
    "description": "Event Sourcing for BEAR.Sunday",
    "license": "MIT",
    "authors": [
        {
            "name": "Akihito Koriyama",
            "email": "akihito.koriyama@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../semantic-logger"
        }
    ],
    "require": {
        "php": "^8.2",
        "bear/semantic-logger": "@dev",
        "ray/di": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "BEAR\\EventSourcing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BEAR\\EventSourcing\\": [
                "tests",
                "tests/Fake"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
