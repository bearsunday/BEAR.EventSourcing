{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "order.get.json",
  "type": "object",
  "title": "Order Detail Response",
  "required": ["id", "order_no", "total", "payment_total", "create_date"],
  "properties": {
    "id": {"type": "integer"},
    "order_no": {"type": "string"},
    "pre_order_id": {"type": ["string", "null"]},
    "message": {"type": ["string", "null"]},
    "name01": {"type": "string"},
    "name02": {"type": "string"},
    "kana01": {"type": ["string", "null"]},
    "kana02": {"type": ["string", "null"]},
    "company_name": {"type": ["string", "null"]},
    "email": {"type": ["string", "null"]},
    "phone_number": {"type": ["string", "null"]},
    "postal_code": {"type": ["string", "null"]},
    "addr01": {"type": ["string", "null"]},
    "addr02": {"type": ["string", "null"]},
    "subtotal": {"type": "number"},
    "discount": {"type": "number"},
    "delivery_fee_total": {"type": "number"},
    "charge": {"type": "number"},
    "tax": {"type": "number"},
    "total": {"type": "number"},
    "payment_total": {"type": "number"},
    "currency_code": {"type": ["string", "null"]},
    "create_date": {"type": "string", "format": "date-time"},
    "update_date": {"type": "string", "format": "date-time"},
    "order_date": {"type": ["string", "null"], "format": "date-time"},
    "payment_date": {"type": ["string", "null"], "format": "date-time"},
    "customer": {"$ref": "#/definitions/Reference"},
    "payment": {"$ref": "#/definitions/Reference"},
    "order_status": {"$ref": "#/definitions/Reference"},
    "customer_order_status": {"$ref": "#/definitions/Reference"},
    "country": {"$ref": "#/definitions/Reference"},
    "pref": {"$ref": "#/definitions/Reference"},
    "sex": {"$ref": "#/definitions/Reference"},
    "job": {"$ref": "#/definitions/Reference"},
    "device_type": {"$ref": "#/definitions/Reference"},
    "order_items": {"type": "array", "items": {"$ref": "#/definitions/Reference"}},
    "shippings": {"type": "array", "items": {"$ref": "#/definitions/Reference"}},
    "mail_historys": {"type": "array", "items": {"$ref": "#/definitions/Reference"}}
  },
  "definitions": {
    "Reference": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "integer"},
        "name": {"type": "string"}
      }
    }
  }
}
