{
    "name": "bear/event-sourcing",
    "description": "Event Sourcing library for BEAR.Sunday",
    "keywords": ["BEAR.Sunday", "Event Sourcing"],
    "license": "MIT",
    "authors": [
        {
            "name": "Akihito Koriyama",
            "email": "akihito.koriyama@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "aura/sql": "^5.0 || ^6.0",
        "bear/resource": "^1.32",
        "ext-json": "*",
        "ramsey/uuid": "^4.9",
        "ray/aop": "^2.19",
        "ray/di": "^2.20"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "BEAR\\EventSourcing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BEAR\\EventSourcing\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "tests": ["@cs", "@test", "@sa"],
        "coverage": ["php -dzend_extension=xdebug.so -dxdebug.mode=coverage ./vendor/bin/phpunit --coverage-text --coverage-html=build/coverage"],
        "pcov": ["php -dextension=pcov.so -d pcov.enabled=1 ./vendor/bin/phpunit --coverage-text --coverage-html=build/coverage --coverage-clover=coverage.xml"],
        "cs": ["phpcs --standard=phpcs.xml src tests"],
        "cs-fix": ["phpcbf --standard=phpcs.xml src tests"],
        "clean": ["phpstan clear-result-cache", "psalm --clear-cache"],
        "stan": ["phpstan analyse -c phpstan.neon --memory-limit=-1 --no-progress"],
        "psalm": ["psalm --monochrome --show-info=false"],
        "sa": ["psalm --monochrome --show-info=false", "phpstan analyse -c phpstan.neon --memory-limit=-1 --no-progress"],
        "metrics": ["@test", "php -d error_reporting=8191 vendor/bin/phpmetrics --report-html=build/metrics src"],
        "phpmd": ["php -d error_reporting=8191 vendor/bin/phpmd src text ./phpmd.xml"],
        "rector": ["rector process --dry-run --no-progress-bar --debug"],
        "rector-fix": ["rector process --no-progress-bar --debug"],
        "require-checker": ["composer-require-checker check composer.json"],
        "build": ["@cs", "@sa", "@pcov", "@metrics"],
        "baseline": ["phpstan analyse -c phpstan.neon --memory-limit=-1 --generate-baseline", "psalm --set-baseline=psalm-baseline.xml"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
