{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "products.get.json",
  "type": "object",
  "title": "Product List Response",
  "required": ["products", "total", "limit", "offset"],
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ProductSummary"
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    }
  },
  "definitions": {
    "ProductSummary": {
      "type": "object",
      "required": ["id", "name", "status", "create_date", "update_date"],
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string",
          "maxLength": 255
        },
        "note": {
          "type": ["string", "null"]
        },
        "description_list": {
          "type": ["string", "null"]
        },
        "description_detail": {
          "type": ["string", "null"]
        },
        "search_word": {
          "type": ["string", "null"]
        },
        "free_area": {
          "type": ["string", "null"]
        },
        "status": {
          "$ref": "#/definitions/Status"
        },
        "create_date": {
          "type": "string",
          "format": "date-time"
        },
        "update_date": {
          "type": "string",
          "format": "date-time"
        },
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProductClassSummary"
          }
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProductImage"
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CategorySummary"
          }
        }
      }
    },
    "Status": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "ProductClassSummary": {
      "type": "object",
      "required": ["id", "price02"],
      "properties": {
        "id": {
          "type": "integer"
        },
        "code": {
          "type": ["string", "null"]
        },
        "price01": {
          "type": ["number", "null"]
        },
        "price02": {
          "type": "number"
        },
        "stock": {
          "type": ["integer", "null"]
        },
        "stock_unlimited": {
          "type": "boolean"
        }
      }
    },
    "ProductImage": {
      "type": "object",
      "required": ["id", "file_name", "sort_no"],
      "properties": {
        "id": {
          "type": "integer"
        },
        "file_name": {
          "type": "string"
        },
        "sort_no": {
          "type": "integer"
        }
      }
    },
    "CategorySummary": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      }
    }
  }
}
