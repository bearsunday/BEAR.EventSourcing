{
    "name": "bear/event-sourcing",
    "description": "Event sourcing primitives extracted from Semantic Logger observations",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Akihito Koriyama",
            "email": "akihito.koriyama@gmail.com"
        }
    ],
    "keywords": [
        "event-sourcing",
        "semantic-logger",
        "events",
        "BEAR.Sunday"
    ],
    "homepage": "https://github.com/bearsunday/BEAR.EventSourcing",
    "support": {
        "issues": "https://github.com/bearsunday/BEAR.EventSourcing/issues",
        "source": "https://github.com/bearsunday/BEAR.EventSourcing"
    },
    "require": {
        "php": "^8.2",
        "koriym/semantic-logger": "^0.8"
    },
    "require-dev": {
        "maglnet/composer-require-checker": "^4.14",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "BEAR\\EventSourcing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BEAR\\EventSourcing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs --standard=phpcs.xml",
        "psalm": "psalm --monochrome --show-info=false",
        "require-checker": "composer-require-checker check composer.json",
        "tests": [
            "@phpcs",
            "@test",
            "@psalm"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.27"
        }
    }
}
