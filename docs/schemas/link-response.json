{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://bearsunday.github.io/BEAR.EventSourcing/schemas/link-response.json",
    "title": "Link response observation",
    "description": "Close context written by SemanticLogLinker: the code of the resource object the request with links returned, or the exception that stopped following the links. The last request followed is the last resource_request nested in the link_request.",
    "type": "object",
    "required": ["durationMs"],
    "anyOf": [{"required": ["code"]}, {"required": ["exception"]}],
    "properties": {
        "code": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
        },
        "exception": {
            "type": "object",
            "required": ["class", "message"],
            "properties": {
                "class": {
                    "type": "string",
                    "minLength": 1
                },
                "message": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "durationMs": {
            "type": "number",
            "minimum": 0,
            "description": "Wall time of all the requests made to follow the links, in milliseconds.",
            "x-volatile": true
        }
    },
    "additionalProperties": false
}
