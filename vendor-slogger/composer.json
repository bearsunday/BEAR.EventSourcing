{
    "name": "bear/semantic-logger",
    "description": "BEAR.Sunday conventions on top of Koriym.SemanticLogger",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "BEAR.Sunday",
            "email": "info@bear-sunday.net"
        }
    ],
    "require": {
        "php": "^8.1",
        "bear/resource": "^1.0",
        "koriym/semantic-logger": "^1.0@dev",
        "ray/di": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "BEAR\\SemanticLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BEAR\\SemanticLogger\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
