{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "product.get.json",
  "type": "object",
  "title": "Product Detail Response",
  "required": ["id", "name", "product_status", "create_date", "update_date"],
  "properties": {
    "id": {"type": "integer"},
    "name": {"type": "string", "maxLength": 255},
    "code": {"type": ["string", "null"]},
    "note": {"type": ["string", "null"]},
    "description_list": {"type": ["string", "null"]},
    "description_detail": {"type": ["string", "null"]},
    "search_word": {"type": ["string", "null"]},
    "free_area": {"type": ["string", "null"]},
    "create_date": {"type": "string", "format": "date-time"},
    "update_date": {"type": "string", "format": "date-time"},
    "product_status": {"$ref": "#/definitions/Reference"},
    "member": {"$ref": "#/definitions/Reference"},
    "product_class": {"type": "array", "items": {"$ref": "#/definitions/Reference"}},
    "product_images": {"type": "array", "items": {"$ref": "#/definitions/Reference"}},
    "product_categorys": {"type": "array", "items": {"$ref": "#/definitions/Reference"}},
    "product_tags": {"type": "array", "items": {"$ref": "#/definitions/Reference"}},
    "customer_favorite_products": {"type": "array", "items": {"$ref": "#/definitions/Reference"}}
  },
  "definitions": {
    "Reference": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "integer"},
        "name": {"type": "string"}
      }
    }
  }
}
