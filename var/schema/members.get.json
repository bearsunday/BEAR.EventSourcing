{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "members.get.json",
  "type": "object",
  "title": "Member List Response",
  "required": ["members", "total", "limit", "offset"],
  "properties": {
    "members": {"type": "array", "items": {"$ref": "#/definitions/Member"}},
    "total": {"type": "integer", "minimum": 0},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100},
    "offset": {"type": "integer", "minimum": 0}
  },
  "definitions": {
    "Member": {
      "type": "object",
      "required": ["id", "name", "login_id", "create_date", "update_date"],
      "properties": {
        "id": {"type": "integer"},
        "name": {"type": "string"},
        "login_id": {"type": "string"},
        "department": {"type": ["string", "null"]},
        "password": {"type": ["string", "null"]},
        "salt": {"type": ["string", "null"]},
        "sort_no": {"type": ["integer", "null"]},
        "two_factor_auth_key": {"type": ["string", "null"]},
        "two_factor_auth_enabled": {"type": "boolean"},
        "create_date": {"type": "string", "format": "date-time"},
        "update_date": {"type": "string", "format": "date-time"},
        "login_date": {"type": ["string", "null"], "format": "date-time"},
        "work": {"$ref": "#/definitions/Reference"},
        "authority": {"$ref": "#/definitions/Reference"},
        "member": {"$ref": "#/definitions/Reference"}
      }
    },
    "Reference": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {"id": {"type": "integer"}, "name": {"type": "string"}}
    }
  }
}
